# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Directory holding the SQLite database (data/store.db).
# Leave unset locally; on Render set it to your disk mount path, e.g. /var/data
# DATA_DIR=/var/data

# Resend email notifications — get your API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Your email address to receive order notifications
# ADMIN_EMAIL=you@example.com
